# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud's
# "Secrets" box (Manage app -> Settings -> Secrets). Pick ONE backend.
#
# Without this file the app saves to .gre_progress/ next to the code, which is
# fine on your own machine but does not survive a Streamlit Cloud reboot and
# never reaches your phone.

# ---------------------------------------------------------------- GitHub Gist
# Easiest cross-device option. Create a fine-grained or classic token with the
# "gist" scope at https://github.com/settings/tokens and paste it below.
# The app finds (or creates) a secret gist called gre-mountain-<profile>.json.
[storage]
backend = "gist"
profile = "default"      # change to keep separate progress for another person

[storage.gist]
token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# gist_id = "0123456789abcdef"   # optional; skip it and the app finds its own

# ---------------------------------------------------------------- Supabase
# [storage]
# backend = "supabase"
# profile = "default"
#
# [storage.supabase]
# url = "https://xxxxxxxxxxxx.supabase.co"
# key = "eyJhbGciOi..."          # anon key is enough with the policy in the README
# table = "gre_progress"

# ---------------------------------------------------------------- Local file
# [storage]
# backend = "local"
# profile = "default"
#
# [storage.local]
# directory = ".gre_progress"
